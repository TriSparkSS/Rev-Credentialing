<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Keep existing /public and /public/... URLs working
    RewriteCond %{REQUEST_URI} ^/public(/|$)
    RewriteRule ^ - [L]

    # Route all other requests into the public directory
    RewriteCond %{REQUEST_URI} !^/public(/|$)
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
